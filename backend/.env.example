# Copy this file to .env and fill in real values before running the server.
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lightoftheword
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d
# Used by routes/explain.js to proxy AI verse explanations.
# Never ship this key inside the mobile app — it must only live here.
ANTHROPIC_API_KEY=sk-ant-your-key-here
CORS_ORIGIN=*
